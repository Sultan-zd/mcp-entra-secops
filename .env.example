# ---------------------------------------------------------------------------
# Modèle de configuration — COPIER en `.env` puis remplir.
# Le fichier `.env` est ignoré par git : aucune valeur réelle ne doit apparaître
# dans ce fichier-ci, qui est versionné.
# ---------------------------------------------------------------------------

# --- Identité de l'application Entra (App Registration) --------------------
# Obligatoires quand ENTRA_DATA_SOURCE=graph.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Source de données ------------------------------------------------------
# graph   : interroge réellement Microsoft Graph (nécessite les 3 valeurs ci-dessus)
# fixture : rejoue des données de démonstration locales, sans tenant ni licence
ENTRA_DATA_SOURCE=fixture

# --- Réglages optionnels ----------------------------------------------------
# ENTRA_LOG_LEVEL=INFO
# ENTRA_DEFAULT_LOOKBACK_HOURS=24
# ENTRA_MAX_LOOKBACK_HOURS=168
# ENTRA_DEFAULT_PAGE_SIZE=25
# ENTRA_MAX_PAGE_SIZE=100
# ENTRA_REQUEST_TIMEOUT_SECONDS=30
# ENTRA_MAX_RETRIES=3
# ENTRA_MAX_PAGES=20

# ===========================================================================
# Serveur MCP de renseignement sur les menaces (threat-intel-mcp)
# ===========================================================================
# Toutes les cles sont FACULTATIVES : le serveur fonctionne avec celles dont
# il dispose et signale les sources manquantes dans ses reponses.
#
# Paliers gratuits :
#   VirusTotal  https://www.virustotal.com/gui/join-us   (~4 req/min)
#   AbuseIPDB   https://www.abuseipdb.com/register       (1000 req/jour)
#   GreyNoise   https://www.greynoise.io/viz/signup      (API communautaire)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=

# live    : interroge reellement les API
# fixture : rejoue un scenario local, sans aucune cle
TI_DATA_SOURCE=fixture

# --- Reglages optionnels ---------------------------------------------------
# TI_CACHE_TTL_SECONDS=86400
# TI_MAX_BULK_INDICATORS=20
# TI_VIRUSTOTAL_RPM=4
# TI_REDIS_URL=redis://localhost:6379/0
# TI_LOG_LEVEL=INFO
