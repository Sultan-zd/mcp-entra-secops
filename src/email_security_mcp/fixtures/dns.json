{
  "_comment": "Zones DNS de DEMONSTRATION, actives quand MAIL_DATA_SOURCE=fixture. Trois profils : teknologiia.com (posture defaillante, SPF au-dela du plafond), bonne-pratique.example (posture exemplaire), et les domaines includes necessaires a l'evaluation recursive du SPF.",
  "zones": {
    "teknologiia.com": {
      "TXT": [
        "v=spf1 include:spf.protection.outlook.com include:_spf.google.com include:servers.mcsv.net include:sendgrid.net include:_spf.salesforce.com include:mail.zendesk.com ~all",
        "MS=ms12345678"
      ],
      "MX": [
        "teknologiia-com.mail.protection.outlook.com"
      ]
    },
    "_dmarc.teknologiia.com": {
      "TXT": [
        "v=DMARC1; p=none; rua=mailto:dmarc@teknologiia.com; pct=100"
      ]
    },
    "selector1._domainkey.teknologiia.com": {
      "TXT": [
        "v=DKIM1; k=rsa; t=y; p=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDdlatRjRjogo3WojgGHFHYLugdUWAY9iR3fy4arWNA1KoS8kVw33cJibXr8bvwUAUparCwlvdbH6dvhkY9iHZ5nQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAECAwEAAQ=="
      ]
    },
    "bonne-pratique.example": {
      "TXT": [
        "v=spf1 ip4:203.0.113.0/24 include:spf.protection.outlook.com -all"
      ],
      "MX": [
        "mail.bonne-pratique.example"
      ]
    },
    "_dmarc.bonne-pratique.example": {
      "TXT": [
        "v=DMARC1; p=reject; sp=reject; adkim=s; aspf=s; pct=100; rua=mailto:dmarc@bonne-pratique.example"
      ]
    },
    "selector1._domainkey.bonne-pratique.example": {
      "TXT": [
        "v=DKIM1; k=rsa; "
      ]
    },
    "sans-protection.example": {
      "TXT": [],
      "MX": [
        "mail.sans-protection.example"
      ]
    },
    "spf.protection.outlook.com": {
