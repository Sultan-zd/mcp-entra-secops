# ---- Secrets : ne JAMAIS committer ----------------------------------------
.env
.env.*
!.env.example
*.pem
*.pfx
*.key

# ---- Environnements virtuels ----------------------------------------------
venv/
.venv/
env/

# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# ---- Outils ---------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Éditeurs / OS --------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# Documents internes Teknologiia : utiles localement, mais un depot public
# n'est pas le bon endroit pour la specification interne d'un employeur.
*.pdf
!docs/*.pdf

# ---- Journal d'audit ------------------------------------------------------
# Les dossiers d'investigation portent des UPN, des adresses IP et des
# verdicts : de la telemetrie de tenant, qui n'a rien a faire dans un depot.
data/
rapport-evaluation.json

# ---- Paquet MCPB ----------------------------------------------------------
# Tout ce qui concerne le paquet distribuable vit dans mcpb/. Ce qui suit est
# REGENERE par `python mcpb/outils/construire.py` : le versionner ajouterait
# 660 Ko de binaire et une copie du code a chaque changement.
*.mcpb
mcpb/dist/
# Cle privee de signature du paquet. La versionner permettrait a quiconque
# lit le depot de signer une version modifiee sous la meme identite.
mcpb/signature/
mcpb/src/
mcpb/.venv/
mcpb/uv.lock
